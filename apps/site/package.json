{
  "name": "@mcpfold/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "mcpfold.com marketing site — public top-of-funnel (design system + shell for E13).",
  "scripts": {
    "dev": "vite",
    "guides:gen": "node scripts/gen-guides.mjs",
    "build": "tsc --noEmit && vite build && vite build --ssr src/ssg/entry-server.tsx --outDir dist-ssr && node scripts/gen-seo.mjs && node scripts/gen-llms.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seo:audit": "node scripts/seo-audit.mjs --self-test",
    "indexnow": "node scripts/indexnow.mjs",
    "e2e": "playwright test",
    "e2e:prerender": "playwright test --config playwright.prerender.config.ts",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@mcpfold/core": "workspace:*",
    "gsap": "^3.15.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.47.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.6"
  }
}
