# Web console environment (Vite). Set these in the Cloudflare Pages project settings; never
# commit real values. The anon key is a public Supabase key (safe in the browser); RLS enforces
# access.
VITE_SUPABASE_URL=https://api.mcpfold.com
VITE_SUPABASE_ANON_KEY=
# Base URL of the mcpfold edge API (device auth / push / pull / teams). Its own host — Supabase
# owns api.mcpfold.com. Defaults to https://functions.mcpfold.com if unset.
VITE_API_URL=https://functions.mcpfold.com
