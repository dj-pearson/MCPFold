{
  "name": "@mcpfold/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "mcpfold web console — visual config editor, directory, and team/sync dashboard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@mcpfold/core": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^19.2.7",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.6"
  }
}
