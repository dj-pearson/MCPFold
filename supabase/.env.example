# Self-hosted Supabase environment (S6.1). Copy to your secret store — Coolify env vars or
# Infisical — and fill in REAL values there. NEVER commit a filled-in copy; `.env` and
# `.env.*` are gitignored. Generate secrets with the commands shown.

# --- Database -----------------------------------------------------------------
POSTGRES_DB=postgres
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- JWT (shared by GoTrue, PostgREST, Realtime) ------------------------------
# Must be >= 32 chars. openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=3600
# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET. Mint them with the
# Supabase self-hosting key generator (see docs/self-hosting.md); they are secrets.
ANON_KEY=
SERVICE_ROLE_KEY=

# --- URLs ---------------------------------------------------------------------
API_EXTERNAL_URL=https://api.mcpfold.com
SITE_URL=https://mcpfold.com
ADDITIONAL_REDIRECT_URLS=https://mcpfold.com/auth/callback

# --- Realtime -----------------------------------------------------------------
# openssl rand -hex 16   (exactly 32 hex chars)
REALTIME_ENC_KEY=
# openssl rand -hex 32   (64 hex chars)
REALTIME_SECRET_KEY_BASE=

# --- Auth: GitHub OAuth (optional; enable for device-code login in S6.3) -------
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_SECRET=
DISABLE_SIGNUP=false
