{
  "name": "@mcpfold/edge",
  "version": "0.0.0",
  "license": "commercial-closed",
  "exports": "./main.ts",
  "tasks": {
    "test": "deno test --allow-net --allow-env",
    "test:unit": "deno test --allow-env test/unit.test.ts",
    "check": "deno check main.ts functions/auth-device/index.ts test/*.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "serve": "deno run --allow-net --allow-env main.ts"
  },
  "imports": {
    "postgres": "npm:postgres@^3.4.5"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
