    "mcpfold",
    "secrets",
    "keychain",
    "1password",
    "infisical",
    "dotenv"
  ],
  "author": "Dan Pearson <dan@danpearson.net> (https://mcpfold.com)",
  "engines": {
    "node": ">=20"
  }
