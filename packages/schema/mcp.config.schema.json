{
  "$id": "https://mcpfold.com/schema/v1.json",
  "$ref": "#/definitions/McpfoldConfig",
  "definitions": {
    "McpfoldConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "servers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "auth": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "bearer",
                      "header",
                      "none"
                    ],
                    "default": "none"
                  },
                  "token": {
                    "type": "string",
                    "pattern": "^\\$\\{[a-z0-9_-]+:.+\\}$"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "$ref": "#/definitions/McpfoldConfig/properties/servers/additionalProperties/properties/auth/properties/token"
                        }
                      ]
                    }
                  }
                },
                "additionalProperties": false
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/McpfoldConfig/properties/servers/additionalProperties/properties/auth/properties/headers/additionalProperties"
                }
              },
              "pin": {
                "type": "string"
              },
              "tools": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "allow",
                      "deny"
                    ]
                  },
                  "list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "mode",
                  "list"
                ],
                "additionalProperties": false
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": [
              "transport"
            ],
            "additionalProperties": false
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "client": {
                "type": "string",
                "enum": [
                  "claude-desktop",
                  "claude-code",
                  "cursor",
                  "vscode",
                  "windsurf",
                  "zed"
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "user",
                  "project",
                  "workspace"
                ],
                "default": "user"
              },
              "path": {
                "type": "string"
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "client",
              "include"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "servers",
        "profiles"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
