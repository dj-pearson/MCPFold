{
  "$id": "https://mcpfold.com/schema/policy-v1.json",
  "$ref": "#/definitions/McpfoldPolicy",
  "definitions": {
    "McpfoldPolicy": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "strict",
            "permissive"
          ],
          "default": "permissive"
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "string",
                "enum": [
                  "name",
                  "package",
                  "namespace",
                  "url"
                ]
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "match",
              "pattern"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "deny": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/McpfoldPolicy/properties/allow/items"
          },
          "default": []
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
