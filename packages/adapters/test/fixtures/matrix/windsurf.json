{
  "mcpServers": {
    "github": {
      "args": [
        "-y",
        "mcp-remote@0.1.38",
        "https://api.githubcopilot.com/mcp/",
        "--header",
        "Authorization: Bearer ${infisical:dev/mcp/GITHUB_PAT}"
      ],
      "command": "npx"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "command": "npx",
      "env": {
        "HEADLESS": "true"
      }
    }
  }
}
