{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "type": "http"
    },
    "playwright": {
      "command": "npx",
      "type": "stdio",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {
        "HEADLESS": "true"
      }
    }
  }
}
