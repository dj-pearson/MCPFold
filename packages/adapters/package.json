{
  "name": "@mcpfold/adapters",
  "version": "1.4.1",
  "description": "Client adapters: render canonical mcpfold config to each client's native format and back.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mcpfold/core": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.4.2",
    "yaml": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dj-pearson/MCPFold.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://mcpfold.com",
  "bugs": {
    "url": "https://github.com/dj-pearson/MCPFold/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcpfold",
    "adapters",
    "claude",
    "cursor",
    "vscode",
    "windsurf",
    "config"
  ],
  "author": "Dan Pearson <dan@danpearson.net> (https://mcpfold.com)",
  "engines": {
    "node": ">=20"
  }
}
