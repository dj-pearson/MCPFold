{
  "name": "mcpfold",
  "version": "1.4.1",
  "description": "One source of truth for your MCP servers — fold one config out to every client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcpfold": "./dist/bin.js",
    "mcpf": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/gen-cli-version.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "dev": "node --experimental-strip-types src/bin.ts"
  },
  "dependencies": {
    "@mcpfold/adapters": "workspace:*",
    "@mcpfold/core": "workspace:*",
    "@mcpfold/proxy": "workspace:*",
    "@mcpfold/secrets": "workspace:*",
    "commander": "^12.1.0",
    "fflate": "^0.8.2",
    "jsonc-parser": "^3.3.1",
    "node-forge": "^1.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dj-pearson/MCPFold.git",
    "directory": "packages/cli"
  },
  "homepage": "https://mcpfold.com",
  "bugs": {
    "url": "https://github.com/dj-pearson/MCPFold/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-client",
    "mcp-proxy",
    "mcp-tools",
    "ai",
    "llm",
    "agents",
    "cli",
    "developer-tools",
    "claude",
    "cursor",
    "context-window",
    "token-optimization",
    "secrets"
  ],
  "author": "Dan Pearson <dan@danpearson.net> (https://mcpfold.com)",
  "engines": {
    "node": ">=20"
  }
}
