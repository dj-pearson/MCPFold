{
  "name": "mcpfold",
  "version": "1.0.0",
  "description": "One source of truth for your MCP servers — fold one config out to every client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcpfold": "./dist/bin.js",
    "mcpf": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "dev": "node --experimental-strip-types src/bin.ts"
  },
  "dependencies": {
    "@mcpfold/adapters": "workspace:*",
    "@mcpfold/core": "workspace:*",
    "@mcpfold/proxy": "workspace:*",
    "@mcpfold/secrets": "workspace:*",
    "commander": "^12.1.0",
    "jsonc-parser": "^3.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dj-pearson/MCPFold.git",
    "directory": "packages/cli"
  },
  "homepage": "https://mcpfold.com",
  "bugs": {
    "url": "https://github.com/dj-pearson/MCPFold/issues"
  }
}
